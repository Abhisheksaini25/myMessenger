# Django Configuration
SECRET_KEY=your-production-django-secret-key-here
DEBUG=True

# Supabase PostgreSQL Configuration
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: postgresql://postgres:[PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Media & Static Files (Optional Overrides)
# MEDIA_ROOT=/path/to/media
# STATIC_ROOT=/path/to/static
